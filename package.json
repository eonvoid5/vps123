{
  "name": "void-host-panel",
  "private": true,
  "version": "1.0.7",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k \"vite --host 0.0.0.0 --port 6969\" \"tsx server/index.ts\" \"tsx server/agent.ts\"",
    "build": "vite build && esbuild server/index.ts --bundle --platform=node --format=cjs --outfile=dist/server.cjs && esbuild server/agent.ts --bundle --platform=node --format=cjs --outfile=dist/agent.cjs",
    "build:panel": "vite build && esbuild server/index.ts --bundle --platform=node --format=cjs --outfile=dist/server.cjs",
    "build:agent": "esbuild server/agent.ts --bundle --platform=node --format=cjs --outfile=dist/agent.cjs",
    "start": "PORT=6969 node dist/server.cjs",
    "start:agent": "AGENT_PORT=8080 node dist/agent.cjs"
  },
  "dependencies": {
    "bcryptjs": "^3.0.2",
    "concurrently": "^9.2.1",
    "cors": "^2.8.5",
    "express": "^5.1.0",
    "jsonwebtoken": "^9.0.2",
    "lucide-react": "^0.468.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "recharts": "^2.15.1"
  },
  "devDependencies": {
    "@types/express": "^5.0.3",
    "@types/jsonwebtoken": "^9.0.9",
    "@types/node": "^22.10.2",
    "@types/react": "^19.0.2",
    "@types/react-dom": "^19.0.2",
    "@vitejs/plugin-react": "^4.4.1",
    "esbuild": "^0.28.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vite": "^6.0.5"
  }
}
